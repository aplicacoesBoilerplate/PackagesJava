<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.aplicacoesBoilerplate</groupId>
    <artifactId>packages-java-parent</artifactId>
    <version>0.0.1</version>
    <packaging>pom</packaging>
    <name>PackagesJava Parent</name>
    <description>Repositorio de packages utilitarios Java - parent multi-modulo (bom + core + starter)</description>
    <url>https://github.com/aplicacoesBoilerplate/PackagesJava</url>

    <modules>
        <module>boilerplate-bom</module>
        <module>boilerplate-core</module>
        <module>boilerplate-starter</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>3.3.6</spring-boot.version>
        <revision>0.0.1</revision>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>br.com.aplicacoesBoilerplate</groupId>
                <artifactId>boilerplate-bom</artifactId>
                <version>${revision}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <distributionManagement>
        <repository>
            <id>github-boilerplate</id>
            <name>GitHub Packages - PackagesJava</name>
            <url>https://maven.pkg.github.com/aplicacoesBoilerplate/PackagesJava</url>
        </repository>
    </distributionManagement>

    <repositories>
        <repository>
            <id>github-boilerplate</id>
            <name>GitHub Packages - PackagesJava</name>
            <url>https://maven.pkg.github.com/aplicacoesBoilerplate/PackagesJava</url>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
